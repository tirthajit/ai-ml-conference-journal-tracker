{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Conference tracker row",
  "type": "object",
  "required": [
    "rank_order",
    "curated_tier",
    "acronym",
    "name",
    "area",
    "full_paper_deadline",
    "deadline_status",
    "deadline_confidence",
    "official_or_tracker_url",
    "last_verified"
  ],
  "properties": {
    "rank_order": {"type": "string", "description": "Display order used by the tracker."},
    "curated_tier": {"type": "string", "enum": ["S", "A", "B", "C"]},
    "acronym": {"type": "string"},
    "name": {"type": "string"},
    "area": {"type": "string"},
    "core_rank_prefill": {"type": "string"},
    "current_or_next_edition": {"type": "string"},
    "conference_dates": {"type": "string"},
    "location": {"type": "string"},
    "abstract_deadline": {"type": "string", "description": "YYYY-MM-DD if known; blank otherwise."},
    "full_paper_deadline": {"type": "string", "description": "YYYY-MM-DD if known; blank otherwise."},
    "timezone": {"type": "string"},
    "deadline_status": {"type": "string"},
    "days_from_2026_06_27": {"type": "string"},
    "deadline_confidence": {"type": "string"},
    "usual_tentative_window": {"type": "string"},
    "official_or_tracker_url": {"type": "string"},
    "notes": {"type": "string"},
    "relevance_tags": {"type": "string"},
    "last_verified": {"type": "string", "description": "YYYY-MM-DD."}
  }
}
