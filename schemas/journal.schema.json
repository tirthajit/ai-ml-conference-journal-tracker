{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Journal tracker row",
  "type": "object",
  "required": [
    "target_priority",
    "journal",
    "area",
    "publisher",
    "metric_source_url",
    "journal_url",
    "last_verified"
  ],
  "properties": {
    "target_priority": {"type": "string", "enum": ["S", "A", "B", "C"]},
    "journal": {"type": "string"},
    "area": {"type": "string"},
    "publisher": {"type": "string"},
    "jcr_quartile_or_rank_note": {"type": "string"},
    "sjr_quartile_note": {"type": "string"},
    "metric_source_url": {"type": "string"},
    "journal_url": {"type": "string"},
    "notes": {"type": "string"},
    "relevance_tags": {"type": "string"},
    "last_verified": {"type": "string", "description": "YYYY-MM-DD."}
  }
}
